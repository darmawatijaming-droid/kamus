        }

        hamburgerBtn.addEventListener('click', toggleSidebar);
        sidebarClose.addEventListener('click', closeSidebar);
        sidebarOverlay.addEventListener('click', closeSidebar);

        window.addEventListener('resize', () => {
            if (window.innerWidth >= 769) {
                closeSidebar();
            }
        });

        // ============================================
        // PRONUNCIATION FUNCTIONS
        // ============================================
        function getWordForPronunciation(word) {
            const clean = word.toLowerCase().trim().split(' ')[0];
            return clean.replace(/[^a-z]/g, '');
        }

        function updatePronunciation(word) {
            const cleanWord = getWordForPronunciation(word);
            const data = pronunciationData[cleanWord];
            
            if (data) {
                currentWord = cleanWord;
                const accentData = data[currentAccent] || data.us;
                pronounceWord.textContent = word;
                pronounceIpa.textContent = accentData.ipa;
                return true;
            } else {
                pronounceWord.textContent = word;
                pronounceIpa.textContent = `/${word.toLowerCase()}/`;
                return false;
            }
        }

        function speakWord(speed = 1) {
            const word = pronounceWord.textContent;
            if (!word) return;

            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(word);
                utterance.lang = 'en-US';
                utterance.rate = speed;
                utterance.pitch = 1;
                const voices = window.speechSynthesis.getVoices();
                if (currentAccent === 'us') {
                    const voice = voices.find(v => v.lang === 'en-US');
                    if (voice) utterance.voice = voice;
                } else {
                    const voice = voices.find(v => v.lang === 'en-GB');
                    if (voice) utterance.voice = voice;
                }
                window.speechSynthesis.speak(utterance);
                return true;
            } else {
                alert('Browser Anda tidak mendukung fitur speech synthesis.');
                return false;
            }
        }

        // ============================================
        // PRONUNCIATION EVENT LISTENERS
        // ============================================
        accentBtns.forEach(btn => {
            btn.addEventListener('click', function() {
                accentBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                currentAccent = this.dataset.accent;
                const word = pronounceWord.textContent;
                updatePronunciation(word);
            });
        });

        btnPlay.addEventListener('click', () => speakWord(1));
        btnSlow.addEventListener('click', () => speakWord(0.6));
        btnRepeat.addEventListener('click', () => speakWord(1));

        btnRecord.addEventListener('click', async function() {
            if (isRecording) {
                if (mediaRecorder) mediaRecorder.stop();
                isRecording = false;
                this.classList.remove('recording');
                this.innerHTML = '<i class="fas fa-microphone"></i> Record';
                recordStatus.innerHTML = '✅ Rekaman selesai. Bandingkan dengan pengucapan asli.';
                return;
            }
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];
                mediaRecorder.ondataavailable = event => audioChunks.push(event.data);
                mediaRecorder.onstop = () => {
                    const audioBlob = new Blob(audioChunks, { type: 'audio/wav' });
                    const audioUrl = URL.createObjectURL(audioBlob);
                    const audio = new Audio(audioUrl);
                    audio.play();
                    recordStatus.innerHTML = '🔊 Putar ulang rekaman Anda. Bandingkan dengan pengucapan asli.';
                };
                mediaRecorder.start();
                isRecording = true;
                this.classList.add('recording');
                this.innerHTML = '<i class="fas fa-stop"></i> Stop';
                recordStatus.innerHTML = '🔴 Merekam... bicarakan kata di atas.';
            } catch (err) {
                alert('Tidak dapat mengakses mikrofon. Pastikan Anda mengizinkan akses mikrofon.');
                console.error(err);
            }
        });

        if ('speechSynthesis' in window) {
            window.speechSynthesis.getVoices();
            window.speechSynthesis.onvoiceschanged = () => {
                window.speechSynthesis.getVoices();
            };
        }

        // ============================================
        // FUNGSI UTAMA
        // ============================================
        function showDashboard() {
            dashboardContainer.style.display = 'flex';
            searchSection.style.display = 'none';
            resultsArea.style.display = 'none';
            resultsArea.innerHTML = '';
            isSearchMode = false;
            
            // Update nav
            document.querySelectorAll('.bottom-nav .nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('navHome').classList.add('active');
            
            // Update sidebar
            const menuItems = sidebarMenu.querySelectorAll('.menu-item');
            menuItems.forEach(item => {
                const cat = item.dataset.cat;
                if (cat === 'dashboard') {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });
            currentCategory = 'dashboard';
            
            // Reset search input
            searchInput.value = '';
        }

        function showSearch() {
            dashboardContainer.style.display = 'none';
            searchSection.style.display = 'block';
            resultsArea.style.display = 'block';
            isSearchMode = true;
            
            // Update nav
            document.querySelectorAll('.bottom-nav .nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('navSearch').classList.add('active');
            
            // Update sidebar
            const menuItems = sidebarMenu.querySelectorAll('.menu-item');
            menuItems.forEach(item => {
                const cat = item.dataset.cat;
                if (cat === 'all') {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });
            currentCategory = 'all';
            
            // Focus search
            setTimeout(() => searchInput.focus(), 100);
            performSearch();
        }

        function filterData(query, category) {
            let filtered = [...kamusData];
            if (query.trim() !== '') {
                const q = query.toLowerCase().trim();
                filtered = filtered.filter(item =>
                    item.indonesia.toLowerCase().includes(q) ||
                    item.inggris.toLowerCase().includes(q) ||
                    item.duri.toLowerCase().includes(q)
                );
            }
            if (category !== 'all' && category !== 'dashboard' && category !== '') {
                filtered = filtered.filter(item =>
                    item.kategori && item.kategori.toLowerCase() === category.toLowerCase()
                );
            }
            return filtered;
        }

        function renderResults(results) {
            if (results.length === 0) {
                resultsArea.innerHTML = `
                    <div class="empty-state">
                        <i class="fas fa-search"></i>
                        <h4>Tidak ada hasil</h4>
                        <p>Coba kata kunci lain atau pilih kategori lain</p>
                    </div>
                `;
                return;
            }

            let html = '';
            results.forEach(item => {
                const catBadge = item.kategori ? `<span class="badge-cat">${item.kategori}</span>` : '';
                const readingGuide = item.reading ? `
                    <div class="reading-guide">
                        <i class="fas fa-book-reader"></i> Cara baca: ${item.reading}
                    </div>
                ` : '';
                
                html += `
                    <div class="word-card">
                        <div class="lang">
                            <div class="lang-label"><i class="fas fa-flag"></i> Indonesia</div>
                            <div class="word">${escapeHtml(item.indonesia)}</div>
                            ${catBadge}
                        </div>
                        <div class="lang">
                            <div class="lang-label"><i class="fas fa-leaf"></i> Duri</div>
                            <div class="word duri">${escapeHtml(item.duri)}</div>
                        </div>
                        <div class="lang">
                            <div class="lang-label"><i class="fas fa-globe"></i> Inggris</div>
                            <div class="word" style="cursor:pointer;" onclick="handleWordClick('${escapeHtml(item.inggris)}')">${escapeHtml(item.inggris)}</div>
                            ${readingGuide}
                        </div>
                    </div>
                `;
            });
            resultsArea.innerHTML = html;
        }

        window.handleWordClick = function(word) {
            updatePronunciation(word);
            setTimeout(() => speakWord(1), 300);
            closeSidebar();
        };

        function performSearch() {
            const query = searchInput.value;
            searchQuery = query;
            const results = filterData(query, currentCategory);
            renderResults(results);
            
            if (results.length > 0) {
                const firstResult = results[0];
                if (firstResult.inggris) {
                    const cleanWord = firstResult.inggris.split('/')[0].trim() || firstResult.inggris;
                    updatePronunciation(cleanWord);
                }
            } else if (query.trim() !== '') {
                updatePronunciation(query);
            }
        }

        function filterByCategory(category) {
            if (category === 'dashboard') {
                showDashboard();
                return;
            }
            
            // Jika bukan dashboard, tampilkan search
            dashboardContainer.style.display = 'none';
            searchSection.style.display = 'block';
            resultsArea.style.display = 'block';
            isSearchMode = true;
            
            currentCategory = category;
            const menuItems = sidebarMenu.querySelectorAll('.menu-item');
            menuItems.forEach(item => {
                const cat = item.dataset.cat;
                if (cat === category) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });
            
            // Update nav
            document.querySelectorAll('.bottom-nav .nav-item').forEach(n => n.classList.remove('active'));
            document.getElementById('navSearch').classList.add('active');
            
            performSearch();
        }

        // ============================================
        // HELPERS
        // ============================================
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        window.updatePronunciation = updatePronunciation;

        // ============================================
        // EVENT LISTENERS
        // ============================================
        searchBtn.addEventListener('click', performSearch);
        searchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') performSearch();
        });

        let debounceTimer;
        searchInput.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(performSearch, 350);
        });

        // Bottom nav
        document.getElementById('navHome').addEventListener('click', showDashboard);
        document.getElementById('navSearch').addEventListener('click', showSearch);
        document.getElementById('navFav').addEventListener('click', function() {
            alert('❤️ Favorit: Belum terhubung ke database. Bisa dikembangkan.');
        });
        document.getElementById('navAbout').addEventListener('click', function() {
            alert('📖 Kamus Duri 3 Bahasa\n' +
                  'Dikembangkan oleh: Darmawati, S.Pd., M.Pd.\n' +
                  'SMPN 1 Anggeraja\n\n' +
                  'Data: 1000+ kata dari komunitas.');
        });

        // ============================================
        // INIT
        // ============================================
        buildSidebar();
        updatePronunciation('Hello');
        
        // Tampilkan dashboard sebagai default
        showDashboard();

        console.log('✅ Kamus Duri dengan Dashboard & Pronunciation siap digunakan!');
    </script>
</body>
</html>
