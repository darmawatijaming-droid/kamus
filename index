<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Kamus Digital DkEDurI - 3 Bahasa</title>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        /* --- RESET & VARIABEL --- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        :root {
            --bg-primary: #0d0f14;
            --bg-secondary: #151a22;
            --glass-bg: rgba(255, 255, 255, 0.06);
            --glass-border: rgba(255, 255, 255, 0.12);
            --glass-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
            --text-primary: #f5f0eb;
            --text-secondary: #b8b0a8;
            --accent-gold: #c9a34b;
            --accent-gold-light: #e8c86a;
            --accent-green: #2a5c4a;
            --accent-green-light: #3d7a63;
            --font-family: 'Inter', sans-serif;
            --font-serif: 'Playfair Display', serif;
            --sidebar-width: 260px;
            --pronounce-blue: #4a90d9;
            --pronounce-blue-light: #6ba9e8;
            --pronounce-blue-dark: #2c6aa0;
            --pronounce-bg: rgba(74, 144, 217, 0.08);
        }
        body {
            font-family: var(--font-family);
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 16px;
            background-image: url('https://i.imgur.com/suDJHJS.jpeg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-blend-mode: overlay;
            background-color: rgba(13, 15, 20, 0.78);
        }
        /* --- APP CONTAINER (GLASS) --- */
        .app-wrapper {
            display: flex;
            width: 100%;
            max-width: 820px;
            min-height: 700px;
            max-height: 95vh;
            background: var(--glass-bg);
            backdrop-filter: blur(18px) saturate(1.4);
            -webkit-backdrop-filter: blur(18px) saturate(1.4);
            border: 1px solid var(--glass-border);
            border-radius: 40px;
            box-shadow: var(--glass-shadow), inset 0 1px 0 rgba(255,255,255,0.08);
            overflow: hidden;
            position: relative;
        }

        /* ============================================
           SIDEBAR STYLES
           ============================================ */
        .sidebar {
            width: var(--sidebar-width);
            min-width: var(--sidebar-width);
            background: rgba(13, 15, 20, 0.7);
            backdrop-filter: blur(12px) saturate(1.6);
            -webkit-backdrop-filter: blur(12px) saturate(1.6);
            border-right: 1px solid rgba(255,255,255,0.06);
            padding: 24px 16px 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            overflow-y: auto;
            transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), margin 0.3s ease;
            flex-shrink: 0;
            z-index: 100;
        }
        .sidebar::-webkit-scrollbar {
            width: 3px;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: var(--accent-gold);
            border-radius: 10px;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            margin-bottom: 8px;
        }
        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sidebar-logo .logo-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(145deg, var(--accent-gold), var(--accent-green));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: #fff;
            box-shadow: 0 4px 12px rgba(201, 163, 75, 0.25);
        }
        .sidebar-logo span {
            font-weight: 700;
            font-size: 18px;
            letter-spacing: -0.3px;
        }
        .sidebar-logo span span {
            color: var(--accent-gold);
        }

        .sidebar-close {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 50%;
            width: 32px;
            height: 32px;
            display: none;
            align-items: center;
            justify-content: center;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.2s;
            font-size: 16px;
        }
        .sidebar-close:hover {
            background: rgba(255,255,255,0.12);
            color: var(--text-primary);
        }

        .sidebar-menu {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex: 1;
        }
        .sidebar-menu .menu-label {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-secondary);
            opacity: 0.4;
            padding: 12px 12px 6px;
        }
        .sidebar-menu .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-secondary);
            cursor: pointer;
            transition: all 0.2s ease;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            font-family: var(--font-family);
        }
        .sidebar-menu .menu-item i {
            width: 20px;
            font-size: 15px;
            color: var(--text-secondary);
            transition: color 0.2s;
        }
        .sidebar-menu .menu-item:hover {
            background: rgba(255,255,255,0.06);
            color: var(--text-primary);
        }
        .sidebar-menu .menu-item:hover i {
            color: var(--accent-gold-light);
        }
        .sidebar-menu .menu-item.active {
            background: linear-gradient(145deg, rgba(201, 163, 75, 0.15), rgba(42, 92, 74, 0.2));
            color: var(--accent-gold-light);
            border: 1px solid rgba(201, 163, 75, 0.12);
        }
        .sidebar-menu .menu-item.active i {
            color: var(--accent-gold-light);
        }

        /* ============================================
           DASHBOARD STYLES
           ============================================ */
        .dashboard-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px 20px;
            text-align: center;
            min-height: 500px;
        }
        .dashboard-avatar {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            background: linear-gradient(145deg, var(--accent-gold), var(--accent-green));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 55px;
            color: #fff;
            box-shadow: 0 8px 32px rgba(201, 163, 75, 0.3);
            margin-bottom: 24px;
            border: 3px solid rgba(201, 163, 75, 0.3);
            transition: transform 0.3s ease;
        }
        .dashboard-avatar:hover {
            transform: scale(1.05);
        }
        .dashboard-name {
            font-family: var(--font-serif);
            font-size: 32px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.5px;
            margin-bottom: 4px;
            background: linear-gradient(135deg, var(--accent-gold-light), var(--accent-gold));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .dashboard-title {
            font-size: 16px;
            font-weight: 500;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }
        .dashboard-school {
            font-size: 14px;
            color: var(--text-secondary);
            opacity: 0.7;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
            justify-content: center;
        }
        .dashboard-school i {
            color: var(--accent-gold-light);
            opacity: 0.6;
        }
        .dashboard-divider {
            width: 80px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
            margin: 12px auto 20px;
            border-radius: 2px;
        }
        .dashboard-bio {
            max-width: 400px;
            font-size: 14px;
            line-height: 1.6;
            color: var(--text-secondary);
            opacity: 0.8;
            font-style: italic;
        }
        .dashboard-bio i {
            color: var(--accent-gold-light);
            opacity: 0.5;
            font-size: 18px;
        }
        .dashboard-stats {
            display: flex;
            gap: 30px;
            margin-top: 24px;
        }
        .dashboard-stats .stat-item {
            text-align: center;
        }
        .dashboard-stats .stat-number {
            font-family: var(--font-serif);
            font-size: 24px;
            font-weight: 700;
            color: var(--accent-gold-light);
        }
        .dashboard-stats .stat-label {
            font-size: 11px;
            color: var(--text-secondary);
            opacity: 0.5;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .dashboard-quote {
            margin-top: 24px;
            padding: 16px 24px;
            background: rgba(201, 163, 75, 0.08);
            border-radius: 16px;
            border-left: 3px solid var(--accent-gold);
            max-width: 450px;
        }
        .dashboard-quote p {
            font-size: 13px;
            color: var(--text-secondary);
            opacity: 0.8;
            font-style: italic;
            line-height: 1.5;
        }
        .dashboard-quote .quote-author {
            font-size: 12px;
            font-weight: 600;
            color: var(--accent-gold-light);
            margin-top: 4px;
            font-style: normal;
        }

        /* ============================================
           PRONUNCIATION SECTION (di sidebar)
           ============================================ */
        .pronounce-section {
            margin-top: 12px;
            padding: 16px 14px;
            background: var(--pronounce-bg);
            border-radius: 16px;
            border: 1px solid rgba(74, 144, 217, 0.15);
            flex-shrink: 0;
        }
        .pronounce-section .pronounce-title {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--pronounce-blue-light);
            opacity: 0.7;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .pronounce-section .pronounce-title i {
            font-size: 14px;
        }

        .accent-selector {
            display: flex;
            gap: 8px;
            margin-bottom: 12px;
        }
        .accent-selector .accent-btn {
            flex: 1;
            padding: 6px 8px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.04);
            color: var(--text-secondary);
            font-size: 11px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            font-family: var(--font-family);
        }
        .accent-selector .accent-btn:hover {
            background: rgba(255,255,255,0.08);
        }
        .accent-selector .accent-btn.active {
            background: rgba(74, 144, 217, 0.2);
            border-color: var(--pronounce-blue);
            color: var(--pronounce-blue-light);
        }
        .accent-selector .accent-btn .flag-icon {
            font-size: 16px;
        }

        .pronounce-word {
            text-align: center;
            padding: 6px 0 2px;
        }
        .pronounce-word .word-display {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            letter-spacing: -0.3px;
        }
        .pronounce-word .ipa-display {
            font-size: 14px;
            color: var(--text-secondary);
            opacity: 0.7;
            font-weight: 400;
            margin-top: 2px;
            font-family: 'Times New Roman', serif;
        }
        .pronounce-word .hint-text {
            font-size: 10px;
            color: var(--text-secondary);
            opacity: 0.5;
            margin-top: 4px;
            font-style: italic;
        }

        .pronounce-controls {
            display: flex;
            gap: 6px;
            margin-top: 10px;
            justify-content: center;
            flex-wrap: wrap;
        }
        .pronounce-controls .ctrl-btn {
            padding: 8px 14px;
            border-radius: 30px;
            border: 1px solid rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.04);
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 6px;
            font-family: var(--font-family);
            flex: 1;
            justify-content: center;
            min-width: 60px;
        }
        .pronounce-controls .ctrl-btn:hover {
            background: rgba(255,255,255,0.08);
            color: var(--text-primary);
        }
        .pronounce-controls .ctrl-btn.primary {
            background: var(--pronounce-blue);
            border-color: var(--pronounce-blue);
            color: #fff;
        }
        .pronounce-controls .ctrl-btn.primary:hover {
            background: var(--pronounce-blue-light);
            border-color: var(--pronounce-blue-light);
        }
        .pronounce-controls .ctrl-btn.slow {
            background: rgba(74, 144, 217, 0.15);
            border-color: rgba(74, 144, 217, 0.2);
            color: var(--pronounce-blue-light);
        }
        .pronounce-controls .ctrl-btn.slow:hover {
            background: rgba(74, 144, 217, 0.25);
        }
        .pronounce-controls .ctrl-btn.record {
            background: rgba(220, 50, 50, 0.15);
            border-color: rgba(220, 50, 50, 0.2);
            color: #e06b6b;
        }
        .pronounce-controls .ctrl-btn.record:hover {
            background: rgba(220, 50, 50, 0.25);
        }
        .pronounce-controls .ctrl-btn.recording {
            background: rgba(220, 50, 50, 0.3);
            border-color: #dc3232;
            color: #ff6b6b;
            animation: pulse-rec 1s ease-in-out infinite;
        }
        @keyframes pulse-rec {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .pronounce-controls .ctrl-btn i {
            font-size: 14px;
        }

        .record-status {
            text-align: center;
            font-size: 10px;
            color: var(--text-secondary);
            opacity: 0.6;
            margin-top: 6px;
            min-height: 18px;
        }

        /* Sidebar Footer */
        .sidebar-footer {
            margin-top: auto;
            padding-top: 16px;
            border-top: 1px solid rgba(255,255,255,0.06);
            font-size: 11px;
            color: var(--text-secondary);
            opacity: 0.5;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        .sidebar-footer .tagline-mini {
            display: flex;
            align-items: center;
            gap: 6px;
            font-weight: 500;
            color: var(--accent-gold-light);
            opacity: 0.8;
        }
        .sidebar-footer .tagline-mini i {
            font-size: 12px;
        }

        /* ============================================
           MAIN CONTENT
           ============================================ */
        .main-content {
            flex: 1;
            padding: 24px 20px 80px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            min-width: 0;
        }
        .main-content::-webkit-scrollbar {
            width: 4px;
        }
        .main-content::-webkit-scrollbar-track {
            background: transparent;
        }
        .main-content::-webkit-scrollbar-thumb {
            background: var(--accent-gold);
            border-radius: 10px;
        }

        .app-header {
            display: flex;
            flex-direction: column;
            gap: 6px;
            padding-bottom: 18px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            flex-shrink: 0;
        }
        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .hamburger-btn {
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 12px;
            width: 40px;
            height: 40px;
            display: none;
            align-items: center;
            justify-content: center;
            color: var(--text-primary);
            cursor: pointer;
            transition: all 0.2s;
            font-size: 20px;
        }
        .hamburger-btn:hover {
            background: rgba(255,255,255,0.12);
        }
        .logo-area {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .logo-icon {
            width: 44px;
            height: 44px;
            background: linear-gradient(145deg, var(--accent-gold), var(--accent-green));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #fff;
            box-shadow: 0 4px 12px rgba(201, 163, 75, 0.3);
        }
        .logo-text {
            font-weight: 700;
            font-size: 20px;
            letter-spacing: -0.5px;
        }
        .logo-text span {
            color: var(--accent-gold);
        }
        .badge-version {
            background: rgba(201, 163, 75, 0.18);
            padding: 4px 10px;
            border-radius: 30px;
            font-size: 10px;
            font-weight: 600;
            color: var(--accent-gold-light);
            border: 1px solid rgba(201, 163, 75, 0.15);
        }
        .tagline {
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            letter-spacing: 0.5px;
            padding-left: 4px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .tagline i {
            color: var(--accent-gold);
            font-size: 14px;
            opacity: 0.8;
        }
        .tagline .highlight {
            color: var(--accent-gold-light);
            font-weight: 600;
        }

        /* --- SEARCH BAR (hidden di dashboard) --- */
        .search-section {
            margin: 18px 0 16px;
            flex-shrink: 0;
        }
        .search-wrapper {
            display: flex;
            background: rgba(0,0,0,0.35);
            border-radius: 60px;
            border: 1px solid rgba(255,255,255,0.08);
            padding: 4px;
            transition: all 0.3s;
            backdrop-filter: blur(4px);
        }
        .search-wrapper:focus-within {
            border-color: var(--accent-gold);
            box-shadow: 0 0 0 3px rgba(201, 163, 75, 0.15);
        }
        .search-wrapper i {
            color: var(--text-secondary);
            padding: 14px 0 14px 18px;
            font-size: 16px;
        }
        .search-wrapper input {
            flex: 1;
            background: transparent;
            border: none;
            padding: 14px 10px;
            font-size: 16px;
            color: var(--text-primary);
            font-weight: 500;
            outline: none;
            min-width: 0;
        }
        .search-wrapper input::placeholder {
            color: var(--text-secondary);
            font-weight: 400;
            opacity: 0.7;
        }
        .search-wrapper button {
            background: linear-gradient(145deg, var(--accent-gold), #a8832f);
            border: none;
            border-radius: 40px;
            padding: 10px 24px;
            font-weight: 600;
            color: #0d0f14;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            white-space: nowrap;
        }
        .search-wrapper button:hover {
            transform: scale(1.02);
            box-shadow: 0 4px 16px rgba(201, 163, 75, 0.4);
        }
        .search-wrapper button i {
            color: #0d0f14;
            padding: 0;
            font-size: 14px;
        }

        /* --- RESULTS AREA --- */
        .results-area {
            flex: 1;
            overflow-y: auto;
            padding-right: 4px;
            margin-top: 6px;
            min-height: 180px;
            display: none;
        }
        .results-area::-webkit-scrollbar {
            width: 3px;
        }
        .results-area::-webkit-scrollbar-thumb {
            background: var(--accent-gold);
            border-radius: 10px;
        }

        /* --- WORD CARD --- */
        .word-card {
            background: rgba(255,255,255,0.04);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 24px;
            padding: 18px 20px;
            margin-bottom: 14px;
            transition: all 0.3s ease;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 12px;
            box-shadow: 0 2px 12px rgba(0,0,0,0.15);
        }
        .word-card:hover {
            background: rgba(255,255,255,0.07);
            border-color: rgba(201, 163, 75, 0.15);
            transform: translateY(-2px);
        }
        .word-card .lang {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .word-card .lang-label {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-secondary);
            opacity: 0.6;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .word-card .lang-label i {
            font-size: 12px;
        }
        .word-card .word {
            font-size: 18px;
            font-weight: 600;
            line-height: 1.3;
            color: var(--text-primary);
            word-break: break-word;
        }
        .word-card .word.duri {
            color: var(--accent-gold-light);
        }
        .word-card .reading-guide {
            font-size: 12px;
            color: var(--pronounce-blue-light);
            opacity: 0.7;
            font-weight: 400;
            font-style: italic;
            margin-top: 2px;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .word-card .reading-guide i {
            font-size: 11px;
            opacity: 0.5;
        }
        .word-card .badge-cat {
            display: inline-block;
            margin-top: 4px;
            font-size: 10px;
            font-weight: 500;
            background: rgba(201, 163, 75, 0.12);
            padding: 2px 12px;
            border-radius: 30px;
            color: var(--accent-gold-light);
            border: 1px solid rgba(201, 163, 75, 0.08);
            width: fit-content;
        }

        /* --- EMPTY STATE --- */
        .empty-state {
            display: flex;
